{
  "manifest_version": 3,
  "name": "Daily Report — Дзвінки та KPI",
  "description": "Швидкі дзвінки, кріти та складні люди у popup з розгортанням до повного звіту без нового вікна.",
  "version": "1.2.0",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Daily Report — швидкий облік",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
